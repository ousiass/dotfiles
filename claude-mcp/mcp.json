{
    "mcpContextUris": [],
    "mcpServers": {
      "supabase": {
        "type": "stdio",
        "command": "sh",
        "args": [
          "-c",
          "set -a; . $HOME/.env; set +a; exec npx -y @supabase/mcp-server-supabase@0.8.2"
        ]
      },
      "deepwiki": {
        "type": "http",
        "url": "https://mcp.deepwiki.com/mcp"
      },
      "nano-banana": {
        "type": "stdio",
        "command": "npx",
        "args": ["-y", "@zhibinyang/nano-banana-mcp"],
        "env": {
          "GEMINI_API_KEY": "${GEMINI_API_KEY}"
        }
      }
    }
}
