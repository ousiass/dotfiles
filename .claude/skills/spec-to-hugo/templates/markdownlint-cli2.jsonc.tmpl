{
  "config": {
    // 行の長さ制限を無効化（日本語ドキュメントでは実用的でない）
    "MD013": false,
    // インラインHTML許可（Hugo shortcode・script等）
    "MD033": false,
    // 最初の見出しをH1に強制しない（frontmatterのtitleがH1）
    "MD041": false,
    // 引用ブロック内の空行を許可
    "MD028": false,
    // 複数H1を許可（1ページ内に複数セクションを含むため）
    "MD025": false,
    // 太字を見出し代わりに使用することを許可（画面設計書のスタイル）
    "MD036": false,
    // 言語未指定のコードブロックを許可（テキスト図など）
    "MD040": false,
    // 同名見出しを許可（「利用できない機能」等の繰り返し）
    "MD024": false
  },
  "globs": ["content/**/*.md"]
}
