{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_LOG_USER_PROMPTS": "1",
    "OTEL_LOG_TOOL_DETAILS": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(npm list:*)",
      "mcp__supabase__search_docs",
      "mcp__supabase__list_projects",
      "mcp__supabase__list_tables",
      "Bash(make lint *)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(jq:*)",
      "Bash(sed:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(date:*)",
      "Bash(tr:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(awk:*)",
      "Bash(cut:*)",
      "Bash(sort:*)",
      "Bash(comm:*)",
      "Bash(printf:*)",
      "Bash(echo:*)",
      "Bash(curl:*)",
      "Bash(mkdir:*)",
      "Bash(rm:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(test:*)",
      "Bash(kill:*)",
      "Bash(ps:*)",
      "Bash(.claude/hooks/check-issue-queue.sh)",
      "Skill(issue-sweep)",
      "Skill(issue-split-auto)",
      "Skill(impl-wt)",
      "Skill(bug-fix-wt)",
      "Skill(design-fix)",
      "Skill(spinoff-issue)"
    ]
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true
  },
  "language": "日本語",
  "alwaysThinkingEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-daltonized",
  "feedbackSurveyState": {
    "lastShownTime": 1753948122944
  },
  "skipAutoPermissionPrompt": true,
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-issue-queue.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "gh issue list --state open --json number,title,labels --limit 20 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
