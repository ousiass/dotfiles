# ----------------------------------------------------------------
# Secrets — マシン依存の機密値は ~/.env に集約
# ----------------------------------------------------------------
.env
**/.env.local
**/.env.*.local

# ----------------------------------------------------------------
# Fish runtime / machine-local state
# ----------------------------------------------------------------
fish/fish_variables*
fish/.claude/

# fisher が管理するプラグインファイル（fish_plugins に基づき各マシンで再生成）
# fisher: jorgebucaran/fisher
fish/functions/fisher.fish
fish/completions/fisher.fish
# z: jethrokuan/z
fish/functions/__z*.fish
fish/conf.d/z.fish
# tide: ilancosman/tide@v6
fish/functions/_tide_*.fish
fish/functions/tide.fish
fish/functions/tide/
fish/functions/fish_prompt.fish
fish/functions/fish_mode_prompt.fish
fish/conf.d/_tide_init.fish
fish/completions/tide.fish

# ----------------------------------------------------------------
# Claude Code runtime data（claude-config の .gitignore を踏襲）
# ----------------------------------------------------------------
# 認証情報
.claude/.credentials.json

# ローカル設定
.claude/settings.local.json
.claude/policy-limits.json

# セッション・キャッシュ・一時データ
.claude/sessions/
.claude/history.jsonl
.claude/stats-cache.json
.claude/cache/
.claude/debug/
.claude/file-history/
.claude/ide/
.claude/paste-cache/
.claude/plans/
.claude/session-env/
.claude/shell-snapshots/
.claude/statsig/
.claude/tasks/
.claude/todos/
.claude/projects/
.claude/telemetry/
.claude/mcp-needs-auth-cache.json

# ランタイム状態
.claude/backups/
.claude/teams/
.claude/llm/active
.claude/usage-data/
.claude/.last-cleanup
.claude/.last-update-result.json
.claude/remote-settings.json

# issue-sweep のランタイム状態（キュー / ロック / メトリクス / 通知 URL）
.sweep/

# herdr runtime data
herdr/*.log
herdr/session.json
herdr/release-notes.json

# Claude worktree runtime data
.claude/worktrees/

# herdr / バックグラウンドジョブのランタイム状態（daemon の control.key を含むため必ず除外）
.claude/daemon/
.claude/daemon.log
.claude/daemon.lock
.claude/daemon.status.json
.claude/jobs/
.claude/gh-pr-status-cache.json

# プラグインローカル設定
.claude/plugins/blocklist.json
.claude/plugins/cache/
.claude/plugins/installed_plugins.json
.claude/plugins/known_marketplaces.json
.claude/plugins/config.json
.claude/plugins/repos/
.claude/plugins/marketplaces/
.claude/plugins/.last_inuse_sweep

# ビルド成果物
.claude/tools/swm/swm

# 外部 agent-skills (bunx skills / ~/.agents/skills/) のマシン依存 symlink 群
# 中身の .gitignore と各 symlink 自身は install_agent_skills が自動生成する
.claude/skills/.gitignore

# plugin marketplace 経由で導入した Cloudflare 公式 skill 群（実体ディレクトリ）。
# agent-skills.txt (bunx skills) の管理外なので、ここで明示的に除外して
# 各マシンで /plugin から再導入する。
.claude/skills/agents-sdk/
.claude/skills/cloudflare/
.claude/skills/cloudflare-email-service/
.claude/skills/cloudflare-one/
.claude/skills/cloudflare-one-migrations/
.claude/skills/durable-objects/
.claude/skills/sandbox-sdk/
.claude/skills/turnstile-spin/
.claude/skills/web-perf/
.claude/skills/workers-best-practices/
.claude/skills/wrangler/

# ----------------------------------------------------------------
# Neovim runtime / plugin lockfile（各マシンで :Lazy sync して再生成）
# ----------------------------------------------------------------
nvim/lazy-lock.json

# ----------------------------------------------------------------
# OS / editor cruft
# ----------------------------------------------------------------
.DS_Store
*.swp
*.swo

# ----------------------------------------------------------------
# Backups created by install.sh
# ----------------------------------------------------------------
*.bak.*
